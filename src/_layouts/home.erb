<!doctype html>
<html lang="<%= data.lang || 'en' %>">
  <head>
    <%= render "head", metadata: site.metadata, title: data.title %>
  </head>
  <body class="home">
    <%= render Shared::Navbar.new(metadata: site.metadata, resource: resource) %>

    <%
      current_lang = data.lang || 'en'
      t = site.data.i18n[current_lang] || site.data.i18n['en']
      prefix = current_lang == 'fi' ? '/fi' : ''
    %>

    <main id="main">
      <article class="intro">
        <p class="intro-lede"><%= t['hero']['subtitle'] %></p>

        <div class="intro-body">
          <p><%= t['hero']['description'] %></p>
        </div>

        <p class="section-label"><%= t['services']['title'] %></p>

        <ul class="work-list">
          <li>
            <h2><a href="<%= relative_url "#{prefix}/services/technical-consulting/" %>"><%= t['services']['technical']['title'] %></a></h2>
            <p><%= t['services']['technical']['description'] %></p>
          </li>
          <li>
            <h2><a href="<%= relative_url "#{prefix}/services/sports-coaching/" %>"><%= t['services']['coaching']['title'] %></a></h2>
            <p><%= t['services']['coaching']['description'] %></p>
          </li>
          <li>
            <h2><a href="<%= relative_url "#{prefix}/services/personal-development/" %>"><%= t['services']['development']['title'] %></a></h2>
            <p><%= t['services']['development']['description'] %></p>
          </li>
        </ul>

        <p class="contact-line">
          <a href="<%= relative_url "#{prefix}/contact/" %>"><%= t['hero']['cta_primary'] %></a>
          ·
          <a href="mailto:<%= site.metadata.email %>"><%= site.metadata.email %></a>
        </p>
      </article>
    </main>

    <%= render "footer", metadata: site.metadata %>
  </body>
</html>
