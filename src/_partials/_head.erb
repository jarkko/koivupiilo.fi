<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<%
  # Language and SEO configuration
  current_lang = data.lang || 'en'
  resource_title = strip_html(strip_newlines(title))
  page_description = data.description || metadata.description

  # Set up translations
  translations = site.data.i18n[current_lang] || site.data.i18n['en']
%>

<title><% if resource_title != "Index" %><%= resource_title %><% else %><%= translations['site']['title'] %>: <%= translations['site']['tagline'] %><% end %></title>

<meta name="description" content="<%= page_description %>" />
<meta name="author" content="Jarkko Laine" />
<meta name="robots" content="index, follow" />

<!-- Language and location meta -->
<html lang="<%= current_lang %>" />
<meta name="language" content="<%= current_lang %>" />
<meta name="geo.region" content="FI" />
<meta name="geo.placename" content="Kangasala, Finland" />

<!-- Open Graph meta -->
<meta property="og:title" content="<%= resource_title != 'Index' ? resource_title : translations['site']['title'] %>" />
<meta property="og:description" content="<%= page_description %>" />
<meta property="og:type" content="website" />
<meta property="og:url" content="<%= absolute_url(resource.relative_url) %>" />
<meta property="og:locale" content="<%= current_lang == 'fi' ? 'fi_FI' : 'en_US' %>" />
<% if current_lang == 'en' %>
<meta property="og:locale:alternate" content="fi_FI" />
<% else %>
<meta property="og:locale:alternate" content="en_US" />
<% end %>

<!-- Twitter Card meta -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%= resource_title != 'Index' ? resource_title : translations['site']['title'] %>" />
<meta name="twitter:description" content="<%= page_description %>" />

<!-- Language alternates for SEO -->
<% if current_lang == 'en' %>
<link rel="alternate" hreflang="fi" href="<%= absolute_url('/fi/') %>" />
<link rel="alternate" hreflang="en" href="<%= absolute_url('/') %>" />
<link rel="alternate" hreflang="x-default" href="<%= absolute_url('/') %>" />
<% else %>
<link rel="alternate" hreflang="en" href="<%= absolute_url('/') %>" />
<link rel="alternate" hreflang="fi" href="<%= absolute_url('/fi/') %>" />
<link rel="alternate" hreflang="x-default" href="<%= absolute_url('/') %>" />
<% end %>

<!-- Canonical URL -->
<link rel="canonical" href="<%= absolute_url(resource.relative_url) %>" />

<!-- Favicon -->
<link rel="icon" href="/favicon.ico" />

<!-- Stylesheets -->
<link rel="stylesheet" href="<%= asset_path :css %>" />

<!-- Scripts (defer for performance) -->
<script src="<%= asset_path :js %>" defer></script>
<%= live_reload_dev_js %>
