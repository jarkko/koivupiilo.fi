<%
  lang = data.lang
  key = data.page_id
  t = site.data.copy[lang]
  page = t.pages[key]
  routes = site.data.routes[key]
  origin = site.config.url
  locale = { "fi" => "fi_FI", "en" => "en_GB" }
%>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title><%= page.title %></title>
<% if routes %>
<meta name="description" content="<%= page.description %>">
<link rel="canonical" href="<%= origin + routes[lang] %>">
<link rel="alternate" hreflang="fi" href="<%= origin + routes["fi"] %>">
<link rel="alternate" hreflang="en" href="<%= origin + routes["en"] %>">
<link rel="alternate" hreflang="x-default" href="<%= origin + routes["fi"] %>">
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= site.data.company.name %>">
<meta property="og:title" content="<%= page.title %>">
<meta property="og:description" content="<%= page.description %>">
<meta property="og:url" content="<%= origin + routes[lang] %>">
<meta property="og:locale" content="<%= locale[lang] %>">
<meta property="og:locale:alternate" content="<%= locale[lang == "fi" ? "en" : "fi"] %>">
<meta name="twitter:card" content="summary">
<% else %>
<meta name="robots" content="noindex">
<% end %>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="<%= asset_path "fonts/hanken-grotesk-latin-400-650.woff2" %>" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="<%= asset_path :css %>">
<%# The trunk grows once per visit: only when the page was reached from outside the site,
    not on a reload or a move between pages. Nothing is stored in the browser. %>
<script>try{var n=performance.getEntriesByType("navigation")[0],r=document.referrer;if(n&&n.type==="navigate"&&(!r||new URL(r).origin!==location.origin))document.documentElement.classList.add("arrive")}catch(e){}</script>
<% if %w[front company].include?(key) %>
<%= render "organization" %>
<% end %>
<%= live_reload_dev_js %>
