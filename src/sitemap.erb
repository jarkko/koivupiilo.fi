---
layout: false
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
<% site.data.routes.each do |_key, paths| %>
<% %w[fi en].each do |lang| %>
  <url>
    <loc><%= site.config.url + paths[lang] %></loc>
    <xhtml:link rel="alternate" hreflang="fi" href="<%= site.config.url + paths["fi"] %>"/>
    <xhtml:link rel="alternate" hreflang="en" href="<%= site.config.url + paths["en"] %>"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="<%= site.config.url + paths["fi"] %>"/>
  </url>
<% end %>
<% end %>
</urlset>
