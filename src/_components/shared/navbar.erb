<header class="site-brand">
  <h1><a href="<%= relative_url home_url %>">koivupiilo.fi</a></h1>
</header>

<nav class="site-nav" aria-label="Main">
  <ul>
    <% nav_items.each do |label, href| %>
      <li>
        <a href="<%= relative_url href %>"
           <% if current_path == href.sub(%r{/$}, "") %>aria-current="page"<% end %>>
          <%= label %>
        </a>
      </li>
    <% end %>
    <li>
      <a href="<%= relative_url language_switch_url %>">
        <%= translations["navigation"]["language_switch"] %>
      </a>
    </li>
  </ul>
</nav>
