  "findings": [
    {
      "id": "F1",
      "severity": "major",
      "rubric": "platform",
      "walk": "W3",
      "message": "Shared header at 390 px with 32 px browser default text: on /en/privacy/ the Koivupiilo wordmark link (x 60-254) runs into the 'Suomeksi' link (x 213-374) and the wordmark's final 'o' covers the 'S'; on /tietosuoja/ the wordmark and 'English' touch with no gap. Not caused by the merge: the earlier review's own capture at cdbf80c1 shows the same overlap (header-en-390-font32-at-cdbf80c1.jpg), and the header markup did not change. Right: let the language link wrap to its own line, or cap the wordmark's em-based width, when the brand row cannot fit both (e.g. flex-wrap with a gap on the brand row), so the two never overlap at large text. Content is still readable and both links still work, so it is not a 1.4.4 failure (browser zoom to 200 % passes), but it is a visible break at a common accessibility setting.",
      "evidence": [
        "docs/design/reviews/evidence/f9fa51b0/header-390-overlap-sheet.jpg",
        "docs/design/reviews/evidence/f9fa51b0/en-390-light-font32.jpg",
        "docs/design/reviews/evidence/f9fa51b0/fi-390-dark-font32.jpg",
        "docs/design/reviews/evidence/f9fa51b0/header-en-390-font32-at-cdbf80c1.jpg",
        "docs/design/reviews/evidence/f9fa51b0/walk-report.json"
      ]
    },
    {
      "id": "F2",
      "severity": "minor",
      "rubric": "platform",
      "walk": "W3",
      "message": "Carried over unchanged from review cdbf80c1 F1 (the merge did not touch the privacy copy or styles): /tietosuoja/ at 390 px with 32 px default text breaks long Finnish words without a hyphen (H1 'Tietosu' / 'oja'). Right: hyphens:auto on lang=fi prose and the display heading, or &shy; in the long compounds.",
      "evidence": [
        "docs/design/reviews/evidence/f9fa51b0/fi-390-dark-font32.jpg",
        "docs/design/reviews/evidence/f9fa51b0/privacy-html-diff-2ed9060-2b81714.txt"
