  "findings": [
    {
      "id": "F1",
      "severity": "major",
      "rubric": "platform",
      "walk": "W3",
      "message": "Known, carried over from f9fa51b0 F1 (pre-existing, not changed by this PR or the PR #6 merge): Shared header at 390 px with 32 px browser default text: on /en/privacy/ the Koivupiilo wordmark link (x 60-254) runs into the 'Suomeksi' link (x 213-374) and the wordmark's final 'o' covers the 'S'; on /tietosuoja/ the wordmark and 'English' touch with no gap. Not caused by the merge: the earlier review's own capture at cdbf80c1 shows the same overlap (header-en-390-font32-at-cdbf80c1.jpg), and the header markup did not change. Right: let the language link wrap to its own line, or cap the wordmark's em-based width, when the brand row cannot fit both (e.g. flex-wrap with a gap on the brand row), so the two never overlap at large text. Content is still readable and both links still work, so it is not a 1.4.4 failure (browser zoom to 200 % passes), but it is a visible break at a common accessibility setting.",
      "evidence": [
        "docs/design/reviews/evidence/f9fa51b0/header-390-overlap-sheet.jpg",
        "docs/design/reviews/evidence/f9fa51b0/en-390-light-font32.jpg",
