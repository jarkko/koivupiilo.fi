  "findings": [
    {
      "id": "F6",
      "severity": "major",
      "rubric": "approved-design",
      "walk": "W0",
      "message": "Carried forward from review 2b66b9b3 F6: / and /en/ show real product names, purposes, honest statuses and checked dates, but no actual product screen. The work is legible in the first viewport; the stronger S-1 visual-proof ambition and references.md proof-above-fold bar remain unmet. Before closing the quality milestone, add one authentic, consent-safe product crop or explicitly reconcile S-1 with the owner. D14/D19 make the short company index the current launch structure, so this retains the previous major design-quality classification rather than inventing a new broken navigation or lifecycle requirement.",
      "evidence": [
        "docs/design/reviews/evidence/c4cc619c/shots/front-fi-1440-light-fi-FI.png",
        "docs/design/reviews/evidence/c4cc619c/shots/front-en-390-light-fi-FI.png",
        "docs/design/reviews/evidence/c4cc619c/quality-assessment.md",
        "docs/design/reviews/evidence/c4cc619c/review-notes.md"
      ]
    }
  ],
  "no_further_issues_reason": "W0–W5 were executed in fi_FI/en_GB; all 13 routes were captured at 390/1440, light/dark, in both locale contexts, plus 320px and computed text enlargement. The prior privacy, missing date, undecided lifecycle, collapsed description and capacity/reply findings were individually retested against D21/D22. No further local blocking defect reproduced. This static site has no forms, mutable collections, destructive actions or loading-data states to fabricate; external product sites, mail-client delivery, real browser zoom, assistive technology and hardware are explicit limits. F6 remains the one major design-quality gap rather than being hidden to manufacture an all-clear.",
  "model_changes": [
    {
      "description": "D3/D19 make Finnish the default, pair translated routes, split Studio and Valmennus, merge company/contact and retain one bilingual 404.",
      "decision_ref": "D19"
    },
    {
      "description": "Standalone work-item marketing pages are replaced by brief introductions and outbound product links.",
      "decision_ref": "D14"
    },
    {
      "description": "Company voice is by name; founder/coaching passages identify the person, with the specifically approved capacity wording governed by D22.",
      "decision_ref": "D16"
    },
    {
      "description": "Four status states, filled/open mark semantics and a checked date beside every occurrence of a work item are recorded in M1.",
      "decision_ref": "D21"
    },
    {
      "description": "The owner-approved capacity line answers W4/S-3; the reply-time promise remains deferred until supplied by the owner.",
      "decision_ref": "D22"
    }
  ],
